{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>CowDogMoo/renovate-config",
    "github>CowDogMoo/renovate-config:go"
  ],
  "packageRules": [
    {
      "description": "Group test dependencies",
      "matchPackageNames": [
        "/test/",
        "/mock/"
      ],
      "groupName": "test dependencies"
    }
  ]
}
